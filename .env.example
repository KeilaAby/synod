# =============================================================================
# SYNOD — modele de configuration
# =============================================================================
# Copier ce fichier en `.env.local` et renseigner les valeurs.
#
#   cp .env.example .env.local
#
# `.env.local` N'EST JAMAIS VERSIONNE (ENF-SEC-09). Ce modele-ci l'est, et il
# ne contient donc AUCUNE valeur reelle — seulement des noms et des exemples de
# forme. Un secret ecrit ici partirait dans l'historique du depot, ou il ne se
# retire pas : il se REVOQUE (voir « Rotation d'un secret » dans README.md).
#
# Ou trouver les valeurs : tableau de bord Supabase du projet,
# Project Settings → API.
# =============================================================================


# -----------------------------------------------------------------------------
# Base de donnees et authentification — OBLIGATOIRES
# -----------------------------------------------------------------------------
# Sans ces deux-la, l'application refuse de demarrer : `lib/env.ts` les valide au
# chargement, pour qu'une variable manquante fasse echouer le build plutot
# qu'une page en production.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cle de SERVICE : elle contourne la RLS. Elle sert aux operations
# d'administration — ouvrir un compte, reinitialiser un mot de passe — et n'est
# lue que cote serveur. Elle ne doit JAMAIS atteindre le navigateur, donc jamais
# porter le prefixe NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=


# -----------------------------------------------------------------------------
# Adresse publique du site
# -----------------------------------------------------------------------------
# Sert a fabriquer les liens envoyes par courriel (reinitialisation de mot de
# passe). En developpement, l'adresse locale convient.

NEXT_PUBLIC_SITE_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Stockage des fichiers — valeurs par defaut convenables
# -----------------------------------------------------------------------------
# Le bucket ne se cree PAS en SQL (`storage.*` appartient a
# `supabase_storage_admin`) : c'est `pnpm db:bucket` qui s'en charge par l'API,
# et il lit ces variables.

STORAGE_BUCKET=synod

# ENF-POR-02/03 — les adaptateurs se choisissent ici, pas dans le code.
# `s3` est prevu au lot 8 et n'est pas encore livre.
AUTH_PROVIDER=supabase
STORAGE_PROVIDER=supabase


# -----------------------------------------------------------------------------
# Serveur d'envoi de courriels — FACULTATIF
# -----------------------------------------------------------------------------
# L'hote, le port, l'expediteur et l'identifiant se reglent A L'ECRAN
# (Administration → Parametres → Courriels). SEUL LE MOT DE PASSE EST ICI :
# une base se sauvegarde, se copie et s'exporte, un secret qui y entre en
# ressort partout.
#
# Tant qu'il est vide, les reglages s'enregistrent mais aucun message ne part —
# le bouton d'essai de l'ecran le dira sans detour.
#
# ⚠  CE FICHIER EST VERSIONNE (exception nommee dans .gitignore). Il porte des
#    NOMS de variables, JAMAIS de valeur reelle : celles-ci vont dans
#    .env.local, que git ignore. Un secret pose ici part avec le depot, et un
#    secret expose ne se retire pas — il se REVOQUE (voir README.md).
#
# Gmail attend un « mot de passe d'application » et non celui du compte :
# seize caracteres, double authentification activee. Hote smtp.gmail.com,
# port 587 (STARTTLS) ou 465 (TLS direct) — les deux se saisissent a l'ecran.

SMTP_PASS=
