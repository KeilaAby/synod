{
  "name": "synod",
  "version": "0.1.0",
  "private": true,
  "description": "SYNOD — plateforme de gestion et de pilotage d'une organisation ecclesiale",
  "scripts": {
    "dev": "next dev",
    "dev:propre": "node -e \"require('node:fs').rmSync('.next', { recursive: true, force: true })\" && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:bundle": "node scripts/build-install-sql.mjs",
    "db:bucket": "node scripts/creer-bucket.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm check:secrets && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:secrets": "node scripts/check-secrets.mjs --all",
    "prepare": "git config core.hooksPath .githooks || exit 0",
    "canevas": "tsx scripts/generer-canevas-import.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.7.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.1",
    "@tanstack/react-table": "^9.0.0",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.84.0",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.18.2"
}
